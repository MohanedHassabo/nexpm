NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://localhost:27017/nexpm
JWT_SECRET=replace-with-a-random-64-character-secret-before-deploying
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REDIS_URL=redis://localhost:6379
# Optional Kafka (enable through explicit deployment configuration)
KAFKA_BROKERS=
VITE_API_URL=/api

# Stripe recurring Prices must be created in Stripe Dashboard first.
PUBLIC_WEB_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Google / Microsoft Calendar OAuth (optional)
PUBLIC_API_URL=http://localhost:4000
CALENDAR_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email verification: use an email delivery provider (Resend API) in production.
# For local-only testing, EMAIL_DEV_LOG_LINK=true prints the verification URL in the API terminal.
RESEND_API_KEY=
EMAIL_FROM=NexPM <verify@example.com>
EMAIL_DEV_LOG_LINK=false

# Platform administrator email allowlist (exact login email, comma-separated).
PLATFORM_ADMIN_EMAILS=
# AES-256-GCM encryption key: openssl rand -hex 32. Required to save provider API keys.
APP_CONFIG_ENCRYPTION_KEY=
# Optional legacy Resend fallback; database settings take precedence.
